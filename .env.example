# saasumkm — copy to .env and fill in for deployment.

# SQLite file on the persistent volume (container path). Local dev: file:./prisma/dev.db
DATABASE_URL="file:/data/prod.db"

# NextAuth signing secret — MUST be >=16 chars, strong & stable.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=***URL (public origin). Set to the tunnel/domain URL in prod, or the tailnet URL for internal testing.
NEXTAUTH_URL=***URL=***(mock while no real gateway; switch to 'midtrans' + keys when going live)
PAYMENT_PROVIDER=mock
# MIDTRANS_SERVER_KEY=***
# MIDTRANS_CLIENT_KEY=***
# MIDTRANS_IS_PRODUCTION=false

NODE_ENV=production
LOG_LEVEL=info
