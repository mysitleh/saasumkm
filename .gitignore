# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# Database
dev.db
dev.db-journal
*.db

# Env
.env
.env.local

# Playwright output (binary heavy)
tests/screenshots/*
!tests/screenshots/desktop-public/
!tests/screenshots/desktop-auth/
!tests/screenshots/mobile/
!tests/screenshots/cinematic-wide/
tests/.playwright/
tests/e2e/.auth/

# Large binary report exports (keep out of git)
docs/*.docx

# Allow the template (not real secrets)
!.env.example

# Separate WhatsApp agent sub-project (own node_modules + WA session creds — never track)
wa-agent-umkm/
